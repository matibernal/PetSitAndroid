<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP (sin TLS) hacia el backend en desarrollo local.
  10.0.2.2 es la IP especial que usa el EMULADOR de Android Studio para
  llegar a "localhost" de tu PC (donde corre el Spring Boot en :8090).
  Para producción, sacá este archivo y usá HTTPS con un dominio real.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
